<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>From the ejs file</title>
  </head>
  <body>
    <div>
      <h1>Hi from the ejs file</h1>
      <% user.forEach((u) => { %>
